# JWT Configuration (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here-REPLACE-WITH-BASE64-32BYTES

# OAuth Configuration
OAUTH_CALLBACK_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Database
DATABASE_URL=postgres://fugue:fugue@localhost:5432/fugue?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# AI Model Configuration (for Bot/Pioneer)
# Use CLI mode (default, uses local chatgpt command):
AI_CLIENT_TYPE=cli
# Or use SDK mode (requires OpenAI API key):
# AI_CLIENT_TYPE=sdk
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o  # or gpt-4-turbo
